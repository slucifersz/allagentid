{
  "name": "allscaleagentid",
  "version": "0.1.0",
  "description": "AllScale Agent ID: on-chain passports for AI agents, A2A settlement through HSP on HSK Chain",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "MODE=local tsx src/server.ts",
    "live": "MODE=live tsx src/server.ts",
    "live:hsp": "MODE=live HSP_MODE=agentic PAYMENT_NETWORK=${PAYMENT_NETWORK:-base-sepolia} STABLECOIN_ADDRESS= TEST_STABLECOIN=0 PORT=4310 PUBLIC_URL=http://localhost:4310 NODE_USE_ENV_PROXY=1 tsx src/server.ts",
    "mcp": "tsx src/mcp-stdio.ts",
    "setup:keys": "tsx src/setup-keys.ts",
    "deploy:passports": "MODE=live tsx src/deploy-live.ts",
    "deploy:test-usdc": "MODE=live tsx src/deploy-test-usdc.ts",
    "check:hsp": "MODE=live tsx src/check-hsp.ts",
    "check:hsp-mcp": "MODE=live tsx src/check-hsp-mcp.ts",
    "typecheck": "tsc --noEmit",
    "faucet": "MODE=live tsx src/faucet.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "viem": "^2.57.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
