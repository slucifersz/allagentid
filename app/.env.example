# local = anvil + HSP Coordinator emulator (no setup needed). live = HSK Chain + hackathon HSP sandbox.
MODE=live
PORT=4300
PUBLIC_URL=http://localhost:4300

# PassportRegistry chain (hackathon rule: HSK mainnet) and payment chain (where the HSP sandbox runs)
REGISTRY_NETWORK=hashkey
PAYMENT_NETWORK=hashkey-testnet

# Wallet that deploys the registry, issues passports and records settlements. Needs a little mainnet HSK.
OPERATOR_PRIVATE_KEY=
# Filled in by npm run deploy:passports
REGISTRY_ADDRESS=

# Which HSP rail pays: builtin | coordinator | merchant | agentic
#   (default: coordinator if HSP_COORDINATOR_URL is set, merchant if HSP_APP_KEY is set, else builtin)
HSP_MODE=

# --- HSP Agentic Payment (HSP QA MCP server; this machine's egress IP must be allowlisted) ---
HSP_MCP_URL=https://mcp-qa.hashkeymerchant.com/
# Team attribution label: identical in every order and query
HSP_MERCHANT_NAME=AllAgentID
# Token symbol to pay in on PAYMENT_NETWORK (from get_chain_config)
HSP_TOKEN=USDC

# --- HashKey Merchant (HSP gateway, https://hashkey-merchant.github.io) ---
# Base URL: QA (testnet) https://merchant-qa.hashkeymerchant.com · stg https://merchant-stg.hashkeymerchant.com · prod https://hsp.hashkey.com
HSP_MERCHANT_BASE_URL=
HSP_APP_KEY=
HSP_APP_SECRET=
# Only once HSP confirms agents may submit Payment Mandates by API; empty = the owner pays at HSP checkout
HSP_PAY_MANDATE_URL=
# ES256K key registered with HSP (default ../keys/merchant_private_key.pem)
MERCHANT_PRIVATE_KEY_PATH=
MERCHANT_NAME=AllAgentID

# --- HSP Settlement Protocol Coordinator ---
# HSP sandbox (Coordinator) from the organizers. Leave empty to use the built-in Coordinator,
# which verifies real USDC transfers on PAYMENT_NETWORK. (The old hsp-hackathon.hashkeymerchant.com
# no longer resolves; ask the organizers for the Mumbai sandbox URL + API key.)
HSP_COORDINATOR_URL=
HSP_API_KEY=
# Faucet base URL if different from the Coordinator
HSP_FAUCET_URL=
# Stablecoin for the built-in Coordinator (defaults to USDC on PAYMENT_NETWORK)
STABLECOIN_ADDRESS=
